UIS_API_USER_ID=                     #UIS SOAP user ID
UIS_API_PASSWORD=                    #UIS SOAP password
UIS_SYNC_CRON=*/5 * * * *            #UIS import schedule; default is every five minutes
UIS_NEW_USERS_LOOKBACK_DAYS=0         #0 means only the current calendar day
